NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:helpdesk@localhost:5432/helpdesk

# The MCP server's public URL: the audience of its access tokens.
MCP_RESOURCE=http://localhost:3000/mcp
# The identity provider. These values point at the development issuer
# (npm run dev:issuer), which serves its keys at the port of OIDC_JWKS_URL.
# For a real provider: its issuer, exactly as the tokens' `iss` names it,
# and the `jwks_uri` of its /.well-known/openid-configuration.
OIDC_ISSUER=http://localhost:3001
OIDC_JWKS_URL=http://localhost:3001/jwks.json
# Optional, for a provider that differs (see "Use a real identity provider" in the tutorial).
# The tokens' `aud`, when it isn't MCP_RESOURCE (Entra ID puts the API's client ID there).
# OIDC_AUDIENCE=
# The `typ` header of the access tokens. Set it empty for a provider that sends none (Entra ID, Okta).
# OIDC_TOKEN_TYPE=at+jwt
# The claim that names the agent's team.
# OIDC_TEAM_CLAIM=team

# The hostnames the Host header may name, comma-separated.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Over stdio there is no token: the team the local user works in. Usually set
# in the MCP client's configuration instead of here.
# HELPDESK_TEAM=billing

# NestJS Observe: `npx @nestjs/observe link` writes these. Empty, the SDK sends nothing.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
